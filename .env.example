# WasteVision AI Environment Configuration Example

# Optional Google Gemini Vision API Key (for Cloud AI Classification)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# App Mode: 'auto', 'local_cv', or 'gemini'
WASTEVISION_MODE=auto

# Optional Geolocation / Maps API Key (for Live Maps integration)
MAPS_API_KEY=your_maps_api_key_here
